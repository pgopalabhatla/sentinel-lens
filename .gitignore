.venv-dashboard/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store
# dataset is regenerable: python -m sentinel_sim.generate --out data --seed 7
data/
# quiet world for the live stream: python -m sentinel_sim.generate --no-incidents --days 35 --seed 11 --out data_live
data_live/
# the quiet world of live week 2, generated by scripts/run_live_week_2.py --run-once (seed 13)
data_live_2/
# triage agent transcripts (sentinel_stream/investigator.py)
runs/
